<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayKnob.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DisplayKnob.App.ViewModels"
    Title="DisplayKnob settings">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.Resources>
      <!-- A Windows 11 settings card: title and description on the left, the control on the right. -->
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
      </Style>
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,20,0,6" />
      </Style>
      <Style x:Key="DescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Content extends into the title bar so Mica runs edge to edge, like Windows Settings. -->
    <!-- The icon is set in code (it is a file next to the exe). -->
    <TitleBar x:Name="AppTitleBar" Height="48" Title="DisplayKnob" />

    <!-- The page title stays put, like Windows Settings, so the cards scroll away below it rather than under the title bar. -->
    <Border Grid.Row="1" MaxWidth="1000" Padding="24,4,24,8" HorizontalAlignment="Stretch">
      <TextBlock HorizontalAlignment="Left" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1000" Padding="24,0,24,32" HorizontalAlignment="Stretch" Spacing="4">

        <!-- General -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" />
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Start with Windows" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Start DisplayKnob in the notification area when you sign in." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Show volume indicator" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Show the level at the bottom of the screen when the volume changes." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.ShowOsd, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Volume -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Volume keys" />
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Step size" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Percent per key press. Hold Shift or Alt for 1%." />
            </StackPanel>
            <NumberBox
                Grid.Column="1"
                VerticalAlignment="Center"
                Minimum="1"
                Maximum="20"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.VolumeStep, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Check the monitor's volume" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Picks up changes made with the monitor's buttons or from another computer." />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                MinWidth="180"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.PollChoiceNames}"
                SelectedIndex="{x:Bind ViewModel.PollIndex, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Keep Windows volume at 100%" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="For a monitor controlled over DDC, so only the monitor's volume lowers the sound." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.PinEndpointVolume, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Windows volume controls the monitor (experimental)" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="The Windows volume icon and slider change the monitor's volume. Windows then shows 98% instead of the monitor's level." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.MirrorWindowsVolume, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Keyboard shortcuts -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Keyboard shortcuts" />
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Volume shortcuts" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="For keyboards without volume keys. Without a DDC monitor as the audio output, they change the Windows volume." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.Hotkeys.Enabled, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Shortcuts" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Up and Down change the volume, M mutes. Use the left Alt key: the right one is AltGr on many keyboards." />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                MinWidth="260"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.Hotkeys.Enabled, Mode=OneWay}"
                ItemsSource="{x:Bind vm:HotkeySettingsViewModel.PresetNames}"
                SelectedIndex="{x:Bind ViewModel.Hotkeys.PresetIndex, Mode=TwoWay}" />
          </Grid>
        </Border>
        <ItemsControl
            ItemsSource="{x:Bind ViewModel.Hotkeys.CustomItems}"
            Visibility="{x:Bind ViewModel.Hotkeys.IsCustom, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Hotkeys.Enabled, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HotkeyItemViewModel">
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                  <Button Grid.Column="1" MinWidth="200" Content="{x:Bind ButtonText, Mode=OneWay}" Command="{x:Bind RecordCommand}" />
                  <Button
                      Grid.Column="2"
                      Command="{x:Bind ClearCommand}"
                      IsEnabled="{x:Bind HasValue, Mode=OneWay}"
                      ToolTipService.ToolTip="Clear"
                      AutomationProperties.Name="Clear shortcut">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <InfoBar
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.Hotkeys.ErrorText, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.Hotkeys.HasError, Mode=OneWay}" />
        <InfoBar
            Severity="Warning"
            IsClosable="False"
            Message="{x:Bind ViewModel.Hotkeys.ConflictText, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.Hotkeys.HasConflict, Mode=OneWay}" />

        <!-- Monitors -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Monitors" />
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoMonitors, Mode=OneWay}">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource DescriptionStyle}" Text="No monitors found. Check that DDC/CI is enabled in the monitor's menu." />
        </Border>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}">
          <ItemsControl.ItemContainerTransitions>
            <TransitionCollection />
          </ItemsControl.ItemContainerTransitions>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MonitorItemViewModel">
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE7F4;" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="{x:Bind Details}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource DescriptionStyle}" Text="Control volume" />
                    <ToggleSwitch MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind DdcVolumeEnabled, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Maximum volume" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Percent of the monitor's range. The volume keys, sliders and indicator then use 0–100 within this limit." />
                  </StackPanel>
                  <!-- The box applies its value on Enter or when it loses focus; the button is for people who click away instead. -->
                  <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- A fixed width, so a long typed value can't push the toggle above it around. Wide enough for the
                         clear button and both spin buttons that appear while the box has focus, which leave little room for the text. -->
                    <NumberBox
                        Width="200"
                        VerticalAlignment="Center"
                        Minimum="10"
                        Maximum="100"
                        SmallChange="5"
                        SpinButtonPlacementMode="Inline"
                        IsEnabled="{x:Bind DdcVolumeEnabled, Mode=OneWay}"
                        Value="{x:Bind MaxVolume, Mode=TwoWay}" />
                    <Button
                        Command="{x:Bind ApplyMaxVolumeCommand}"
                        IsEnabled="{x:Bind DdcVolumeEnabled, Mode=OneWay}"
                        ToolTipService.ToolTip="Apply"
                        AutomationProperties.Name="Apply maximum volume">
                      <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Volume curve" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Logarithmic takes finer steps at low volume and bigger ones at high volume. Try it if the lowest levels are too loud or the top ones do nothing." />
                  </StackPanel>
                  <ComboBox
                      Grid.Row="2"
                      Grid.Column="2"
                      Width="200"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      IsEnabled="{x:Bind DdcVolumeEnabled, Mode=OneWay}"
                      ItemsSource="{x:Bind CurveNames}"
                      SelectedIndex="{x:Bind CurveIndex, Mode=TwoWay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Audio outputs -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Audio outputs" />
        <TextBlock Style="{StaticResource DescriptionStyle}" Margin="2,0,0,6" Text="Which monitor each audio output plays through. The volume keys control that monitor while the output is the default." />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Endpoints}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EndpointItemViewModel">
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE7F5;" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Default output" Visibility="{x:Bind IsDefault}" />
                  </StackPanel>
                  <ComboBox
                      Grid.Column="2"
                      MinWidth="220"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind Choices}"
                      SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
