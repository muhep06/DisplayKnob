<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayKnob.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DisplayKnob.App.ViewModels"
    Title="DisplayKnob settings">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.Resources>
      <!-- A Windows 11 settings card: title and description on the left, the control on the right. -->
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
      </Style>
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,20,0,6" />
      </Style>
      <Style x:Key="DescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Content extends into the title bar so Mica runs edge to edge, like Windows Settings. -->
    <TitleBar x:Name="AppTitleBar" Height="48" Title="DisplayKnob">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xE7F4;" />
      </TitleBar.IconSource>
    </TitleBar>

    <!-- The page title stays put, like Windows Settings, so the cards scroll away below it rather than under the title bar. -->
    <Border Grid.Row="1" MaxWidth="1000" Padding="24,4,24,8" HorizontalAlignment="Stretch">
      <TextBlock HorizontalAlignment="Left" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1000" Padding="24,0,24,32" HorizontalAlignment="Stretch" Spacing="4">

        <!-- General -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" />
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Start with Windows" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Start DisplayKnob in the notification area when you sign in." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Show volume indicator" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Show the level at the bottom of the screen when the volume changes." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.ShowOsd, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Volume -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Volume keys" />
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Step size" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Percent per key press. Hold Shift or Alt for 1%." />
            </StackPanel>
            <NumberBox
                Grid.Column="1"
                VerticalAlignment="Center"
                Minimum="1"
                Maximum="20"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.VolumeStep, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Check the monitor's volume" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="Picks up changes made with the monitor's buttons or from another computer." />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                MinWidth="180"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.PollChoiceNames}"
                SelectedIndex="{x:Bind ViewModel.PollIndex, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Keep Windows volume at 100%" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="For a monitor controlled over DDC, so only the monitor's volume lowers the sound." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.PinEndpointVolume, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Windows volume controls the monitor (experimental)" />
              <TextBlock Style="{StaticResource DescriptionStyle}" Text="The Windows volume icon and slider change the monitor's volume. Windows then shows 98% instead of the monitor's level." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.MirrorWindowsVolume, Mode=TwoWay}" />
          </Grid>
        </Border>

        <!-- Monitors -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Monitors" />
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoMonitors, Mode=OneWay}">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource DescriptionStyle}" Text="No monitors found. Check that DDC/CI is enabled in the monitor's menu." />
        </Border>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}">
          <ItemsControl.ItemContainerTransitions>
            <TransitionCollection />
          </ItemsControl.ItemContainerTransitions>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MonitorItemViewModel">
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE7F4;" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="{x:Bind Details}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource DescriptionStyle}" Text="Control volume" />
                    <ToggleSwitch MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind DdcVolumeEnabled, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Audio outputs -->
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Audio outputs" />
        <TextBlock Style="{StaticResource DescriptionStyle}" Margin="2,0,0,6" Text="Which monitor each audio output plays through. The volume keys control that monitor while the output is the default." />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Endpoints}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EndpointItemViewModel">
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE7F5;" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Default output" Visibility="{x:Bind IsDefault}" />
                  </StackPanel>
                  <ComboBox
                      Grid.Column="2"
                      MinWidth="220"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind Choices}"
                      SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
