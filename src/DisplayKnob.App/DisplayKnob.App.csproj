<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayKnob.App</RootNamespace>
    <AssemblyName>DisplayKnob</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DisplayKnob.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <!-- WinUI has no AnyCPU build; building the project on its own must land in the same bin\x64 folder as the solution build. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- WinUI 3, unpackaged, self-contained -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Program.cs owns Main so Velopack can handle install/update hooks before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- CsWin32 generates unsafe interop code (OSD window styles). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also next to the exe: the settings window loads it for its title bar and taskbar button. -->
    <Content Include="Assets\DisplayKnob.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplayKnob.Core\DisplayKnob.Core.csproj" />
  </ItemGroup>

  <!-- `dotnet publish` leaves out the compiled XAML (.xbf) and the project's resource index (.pri) of an unpackaged
       WinUI app, so a published exe fails to load its first window (XamlParseException at startup). Both are in the
       build output; add them to the publish list. -->
  <Target Name="IncludeWinUIOutputInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_WinUIOutput Include="$(OutDir)**\*.xbf" />
      <_WinUIOutput Include="$(OutDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_WinUIOutput)" RelativePath="%(_WinUIOutput.RecursiveDir)%(_WinUIOutput.Filename)%(_WinUIOutput.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
