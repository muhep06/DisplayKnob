<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayKnob.App.Osd.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplayKnob volume">

  <!-- Modeled on the Windows 11 volume flyout: icon, rounded level bar, number. -->
  <Grid x:Name="Root" Padding="14,0,14,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <FontIcon
        Grid.Column="0"
        VerticalAlignment="Center"
        FontFamily="{ThemeResource SymbolThemeFontFamily}"
        FontSize="16"
        Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
      <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Opacity="0.75"
          Text="{x:Bind ViewModel.MonitorName, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          Visibility="{x:Bind ViewModel.ShowMonitorName, Mode=OneWay}" />

      <Grid Height="4" Opacity="{x:Bind ViewModel.BarOpacity, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{x:Bind ViewModel.FilledLength, Mode=OneWay}" />
          <ColumnDefinition Width="{x:Bind ViewModel.EmptyLength, Mode=OneWay}" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="2" />
        <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
      </Grid>
    </StackPanel>

    <TextBlock
        Grid.Column="2"
        MinWidth="22"
        VerticalAlignment="Center"
        Style="{ThemeResource BodyTextBlockStyle}"
        Text="{x:Bind ViewModel.LevelText, Mode=OneWay}"
        TextAlignment="Right" />
  </Grid>
</Window>
