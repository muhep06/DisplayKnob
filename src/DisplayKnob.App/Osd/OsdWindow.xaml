<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayKnob.App.Osd.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplayKnob volume">

  <Grid x:Name="Root" Padding="18,0,18,0" ColumnSpacing="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <FontIcon
        Grid.Column="0"
        VerticalAlignment="Center"
        FontFamily="{ThemeResource SymbolThemeFontFamily}"
        FontSize="18"
        Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
      <TextBlock
          Style="{ThemeResource CaptionTextBlockStyle}"
          Opacity="0.75"
          Text="{x:Bind ViewModel.MonitorName, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          Visibility="{x:Bind ViewModel.ShowMonitorName, Mode=OneWay}" />
      <ProgressBar
          Maximum="100"
          Minimum="0"
          Opacity="{x:Bind ViewModel.BarOpacity, Mode=OneWay}"
          Value="{x:Bind ViewModel.Level, Mode=OneWay}" />
    </StackPanel>

    <TextBlock
        Grid.Column="2"
        MinWidth="30"
        VerticalAlignment="Center"
        Style="{ThemeResource BodyStrongTextBlockStyle}"
        Text="{x:Bind ViewModel.LevelText, Mode=OneWay}"
        TextAlignment="Right" />
  </Grid>
</Window>
