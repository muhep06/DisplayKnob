<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayKnob.App.Osd.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplayKnob volume">

  <!-- Modeled on the Windows 11 volume flyout: icon, slider, number. -->
  <Grid x:Name="Root" Padding="16,0,18,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <FontIcon
        Grid.Column="0"
        VerticalAlignment="Center"
        FontFamily="{ThemeResource SymbolThemeFontFamily}"
        FontSize="16"
        Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" />

    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock
          Margin="0,0,0,-6"
          Style="{ThemeResource CaptionTextBlockStyle}"
          Opacity="0.75"
          Text="{x:Bind ViewModel.MonitorName, Mode=OneWay}"
          TextTrimming="CharacterEllipsis"
          Visibility="{x:Bind ViewModel.ShowMonitorName, Mode=OneWay}" />
      <!-- Display only: the window is click-through and never focused. -->
      <Slider
          IsHitTestVisible="False"
          IsTabStop="False"
          Maximum="100"
          Minimum="0"
          Opacity="{x:Bind ViewModel.BarOpacity, Mode=OneWay}"
          Value="{x:Bind ViewModel.Level, Mode=OneWay}" />
    </StackPanel>

    <TextBlock
        Grid.Column="2"
        MinWidth="24"
        VerticalAlignment="Center"
        Style="{ThemeResource BodyTextBlockStyle}"
        Text="{x:Bind ViewModel.LevelText, Mode=OneWay}"
        TextAlignment="Right" />
  </Grid>
</Window>
